<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_builder">

    <TextView
        android:id="@+id/btnBack"
        android:layout_width="57dp"
        android:layout_height="49dp"
        android:background="@drawable/btn_back"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pixel_regular"
        android:gravity="center"
        android:text="BUILD YOUR ARMY"
        android:textColor="#F4EFE6"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/pixel_regular"
        android:text="CLAN"
        android:textColor="#B8BCCB"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">


        <LinearLayout
            android:id="@+id/btnClanForsythe"
            android:layout_width="10dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/btn_empty_start">

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:contentDescription="Forsythe clan"
                android:src="@drawable/forsythe" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pixel_regular"
                android:text="FORSYTHE"
                android:textColor="#F4EFE6"
                android:textSize="13sp" />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/btnClanLeone"
            android:layout_width="10dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/btn_empty_start">
            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/leone"
                android:contentDescription="Leone clan" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pixel_regular"
                android:text="LEONE"
                android:textColor="#F4EFE6"
                android:textSize="13sp" />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/btnClanBaccus"
            android:layout_width="10dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/btn_empty_start">
            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/baccus"
                android:contentDescription="Baccus clan" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pixel_regular"
                android:text="BACCUS"
                android:textColor="#F4EFE6"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="ARMY SIZE"
        android:fontFamily="@font/pixel_regular"
        android:textColor="#B8BCCB"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">


        <TextView
            android:id="@+id/btnSize15"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:gravity="center"
            android:fontFamily="@font/pixel_regular"
            android:text="15"
            android:textColor="#F4EFE6"
            android:textSize="22sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/btn_empty_small"/>


        <TextView
            android:id="@+id/btnSize20"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:gravity="center"
            android:text="20"
            android:textColor="#F4EFE6"
            android:textSize="22sp"
            android:fontFamily="@font/pixel_regular"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/btn_empty_small" />


        <TextView
            android:id="@+id/btnSize30"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:gravity="center"
            android:text="30"
            android:textColor="#F4EFE6"
            android:textSize="22sp"
            android:fontFamily="@font/pixel_regular"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/btn_empty_small" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="DIFFICULTY"
        android:fontFamily="@font/pixel_regular"
        android:textColor="#B8BCCB"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">


        <TextView
            android:id="@+id/btnEasy"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:gravity="center"
            android:text="EASY"
            android:textColor="#F4EFE6"
            android:textSize="16sp"
            android:fontFamily="@font/pixel_regular"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/btn_empty_wide" />


        <TextView
            android:id="@+id/btnMedium"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:gravity="center"
            android:text="MEDIUM"
            android:fontFamily="@font/pixel_regular"
            android:textColor="#F4EFE6"
            android:textSize="16sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/btn_empty_wide" />


        <TextView
            android:id="@+id/btnHard"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:gravity="center"
            android:text="HARD"
            android:textColor="#F4EFE6"
            android:textSize="16sp"
            android:fontFamily="@font/pixel_regular"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/btn_empty_wide" />
    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnRandomize"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:gravity="center"
            android:fontFamily="@font/pixel_regular"
            android:background="@drawable/btn_empty_wide"
            android:text="Randomize"
            android:textColor="#F4EFE6" />

        <TextView
            android:id="@+id/btnEven"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/btn_empty_wide"
            android:fontFamily="@font/pixel_regular"
            android:text="Even"
            android:textColor="#F4EFE6" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="160dp"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:padding="14dp"
        android:background="@drawable/button_empty_start_selected">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtSoldiersHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:fontFamily="@font/pixel_regular"
                android:clickable="true"
                android:focusable="true"
                android:textColor="#F4EFE6"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/txtPointsLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FCA311"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtStrengthLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="150dp"
            android:text="Strength"
            android:fontFamily="@font/pixel_regular"
            android:textColor="#B8BCCB"
            android:textSize="12sp" />

        <ScrollView
            android:id="@+id/scrollRoster"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp">
            <LinearLayout
                android:id="@+id/rosterContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <TextView
        android:id="@+id/btnStartBattle"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/btn_empty_wide"
        android:fontFamily="@font/pixel_regular"
        android:text="START BATTLE"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />
</LinearLayout>
