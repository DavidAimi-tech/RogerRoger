<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/background_portrait"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="-52dp" />

    <!-- where the enemy card starts (moved down from the top edge); adjust to taste -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/topGuide"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.12" />

    <!-- enemy card, top of a vertical chain: enemy card / centre stack / player card.
         spread_inside gives the same gap above and below the centre stack. -->
    <include
        android:id="@+id/enemyCard"
        layout="@layout/view_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="H,878:1154"
        app:layout_constraintWidth_percent="0.32"
        app:layout_constraintVertical_chainStyle="spread_inside"
        app:layout_constraintTop_toBottomOf="@id/topGuide"
        app:layout_constraintBottom_toTopOf="@id/centerStack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- dialogue box + log box glued together as one item, centred -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/centerStack"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintWidth_percent="0.44"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/enemyCard"
        app:layout_constraintBottom_toTopOf="@id/playerCard">

        <!-- dialogue box: commander lines -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/dialogueBox"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="H,1056:312"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.Guideline android:id="@+id/dSplit"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="vertical" app:layout_constraintGuide_percent="0.25" />
            <!-- portrait window -->
            <androidx.constraintlayout.widget.Guideline android:id="@+id/wL"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="vertical" app:layout_constraintGuide_percent="0.0568" />
            <androidx.constraintlayout.widget.Guideline android:id="@+id/wR"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="vertical" app:layout_constraintGuide_percent="0.1932" />
            <androidx.constraintlayout.widget.Guideline android:id="@+id/wT"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" app:layout_constraintGuide_percent="0.173" />
            <androidx.constraintlayout.widget.Guideline android:id="@+id/wB"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" app:layout_constraintGuide_percent="0.6346" />
            <!-- name plate -->
            <androidx.constraintlayout.widget.Guideline android:id="@+id/nL"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="vertical" app:layout_constraintGuide_percent="0.0455" />
            <androidx.constraintlayout.widget.Guideline android:id="@+id/nR"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="vertical" app:layout_constraintGuide_percent="0.2045" />
            <androidx.constraintlayout.widget.Guideline android:id="@+id/nT"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" app:layout_constraintGuide_percent="0.769" />
            <androidx.constraintlayout.widget.Guideline android:id="@+id/nB"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" app:layout_constraintGuide_percent="0.865" />

            <ImageView
                android:layout_width="0dp" android:layout_height="0dp"
                android:scaleType="fitXY" android:src="@drawable/dialogue_portrait"
                android:importantForAccessibility="no"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="@id/dSplit"
                app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />

            <ImageView
                android:id="@+id/commanderArt"
                android:layout_width="0dp" android:layout_height="0dp"
                android:scaleType="centerCrop"
                android:contentDescription="Your commander"
                app:layout_constraintStart_toStartOf="@id/wL" app:layout_constraintEnd_toEndOf="@id/wR"
                app:layout_constraintTop_toTopOf="@id/wT" app:layout_constraintBottom_toBottomOf="@id/wB" />

            <TextView
                android:id="@+id/commanderName"
                style="@style/InkValue"
                android:layout_width="0dp" android:layout_height="0dp"
                app:autoSizeTextType="uniform" app:autoSizeMinTextSize="5sp" app:autoSizeMaxTextSize="9sp"
                app:layout_constraintStart_toStartOf="@id/nL" app:layout_constraintEnd_toEndOf="@id/nR"
                app:layout_constraintTop_toTopOf="@id/nT" app:layout_constraintBottom_toBottomOf="@id/nB" />

            <ImageView
                android:layout_width="0dp" android:layout_height="0dp"
                android:scaleType="fitXY" android:src="@drawable/dialogue_wide"
                android:importantForAccessibility="no"
                app:layout_constraintStart_toStartOf="@id/dSplit" app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />

            <!-- commander lines go here (CommanderDialogue.opening / lineFor) -->
            <ScrollView
                android:id="@+id/scrollCommander"
                android:layout_width="0dp" android:layout_height="0dp"
                android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
                android:layout_marginTop="6dp" android:layout_marginBottom="6dp"
                android:fillViewport="true"
                android:scrollbars="vertical"
                android:overScrollMode="always"
                app:layout_constraintStart_toStartOf="@id/dSplit" app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent">
                <TextView
                    android:id="@+id/commanderLine"
                    style="@style/InkValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"
                    android:gravity="center"
                    android:textSize="10sp"
                    android:maxLines="100"
                    android:singleLine="false"
                    android:ellipsize="none"
                    app:autoSizeTextType="none" />
            </ScrollView>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- logbox: centred directly under the dialogue box, roughly half the enemy card's height.
             Holds BattleEngine's regular round log (playRound / skipRound return value). -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/logBox"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="H,792:240"
            app:layout_constraintWidth_percent="0.818"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dialogueBox"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:layout_width="0dp" android:layout_height="0dp"
                android:scaleType="fitXY" android:src="@drawable/dialogue_wide"
                android:importantForAccessibility="no"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />

            <androidx.constraintlayout.widget.Guideline android:id="@+id/lbL"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="vertical" app:layout_constraintGuide_percent="0.06" />
            <androidx.constraintlayout.widget.Guideline android:id="@+id/lbR"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="vertical" app:layout_constraintGuide_percent="0.94" />
            <androidx.constraintlayout.widget.Guideline android:id="@+id/lbT"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" app:layout_constraintGuide_percent="0.14" />
            <androidx.constraintlayout.widget.Guideline android:id="@+id/lbB"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" app:layout_constraintGuide_percent="0.86" />

            <ScrollView
                android:id="@+id/scrollLog"
                android:layout_width="0dp" android:layout_height="0dp"
                app:layout_constraintStart_toStartOf="@id/lbL" app:layout_constraintEnd_toEndOf="@id/lbR"
                app:layout_constraintTop_toTopOf="@id/lbT" app:layout_constraintBottom_toBottomOf="@id/lbB">
                <TextView
                    android:id="@+id/txtLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:textColor="#3A2614"
                    android:textSize="9sp" />
            </ScrollView>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout><!-- end centerStack -->

    <!-- your card, sitting directly on top of the checkbox -->
    <include
        android:id="@+id/playerCard"
        layout="@layout/view_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="0dp"
        app:layout_constraintDimensionRatio="H,878:1154"
        app:layout_constraintWidth_percent="0.32"
        app:layout_constraintTop_toBottomOf="@id/centerStack"
        app:layout_constraintBottom_toTopOf="@id/checkCapture"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- scoreboard, left side (original position) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/scoreboard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="4dp"
        app:layout_constraintDimensionRatio="H,176:560"
        app:layout_constraintWidth_percent="0.18"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.47">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/scoreboard"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0" />

        <androidx.constraintlayout.widget.Guideline android:id="@+id/sbL"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" app:layout_constraintGuide_percent="0.18" />
        <androidx.constraintlayout.widget.Guideline android:id="@+id/sbR"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" app:layout_constraintGuide_percent="0.82" />
        <androidx.constraintlayout.widget.Guideline android:id="@+id/sbC1"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" app:layout_constraintGuide_percent="0.2045" />
        <androidx.constraintlayout.widget.Guideline android:id="@+id/sbC3"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" app:layout_constraintGuide_percent="0.795" />
        <androidx.constraintlayout.widget.Guideline android:id="@+id/sbEnemyY"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" app:layout_constraintGuide_percent="0.2036" />
        <androidx.constraintlayout.widget.Guideline android:id="@+id/sbRoundY"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" app:layout_constraintGuide_percent="0.464" />
        <androidx.constraintlayout.widget.Guideline android:id="@+id/sbYouY"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" app:layout_constraintGuide_percent="0.675" />
        <androidx.constraintlayout.widget.Guideline android:id="@+id/sbStatY"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" app:layout_constraintGuide_percent="0.882" />

        <TextView android:id="@+id/txtEnemyCount" style="@style/PixelValue"
            android:layout_width="0dp" android:layout_height="wrap_content"
            app:autoSizeTextType="uniform" app:autoSizeMinTextSize="10sp" app:autoSizeMaxTextSize="30sp"
            app:layout_constraintStart_toStartOf="@id/sbL" app:layout_constraintEnd_toEndOf="@id/sbR"
            app:layout_constraintTop_toTopOf="@id/sbEnemyY" app:layout_constraintBottom_toBottomOf="@id/sbEnemyY" />
        <TextView android:id="@+id/txtRound" style="@style/PixelValue"
            android:layout_width="0dp" android:layout_height="wrap_content"
            app:autoSizeTextType="uniform" app:autoSizeMinTextSize="8sp" app:autoSizeMaxTextSize="22sp"
            app:layout_constraintStart_toStartOf="@id/sbL" app:layout_constraintEnd_toEndOf="@id/sbR"
            app:layout_constraintTop_toTopOf="@id/sbRoundY" app:layout_constraintBottom_toBottomOf="@id/sbRoundY" />
        <TextView android:id="@+id/txtYouCount" style="@style/PixelValue"
            android:layout_width="0dp" android:layout_height="wrap_content"
            app:autoSizeTextType="uniform" app:autoSizeMinTextSize="10sp" app:autoSizeMaxTextSize="30sp"
            app:layout_constraintStart_toStartOf="@id/sbL" app:layout_constraintEnd_toEndOf="@id/sbR"
            app:layout_constraintTop_toTopOf="@id/sbYouY" app:layout_constraintBottom_toBottomOf="@id/sbYouY" />

        <TextView android:id="@+id/txtSkips" style="@style/PixelValue"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp"
            app:layout_constraintStart_toStartOf="@id/sbC1" app:layout_constraintEnd_toEndOf="@id/sbC1"
            app:layout_constraintTop_toTopOf="@id/sbStatY" app:layout_constraintBottom_toBottomOf="@id/sbStatY" />
        <TextView android:id="@+id/txtTrumps" style="@style/PixelValue"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/sbStatY" app:layout_constraintBottom_toBottomOf="@id/sbStatY" />
        <TextView android:id="@+id/txtCaptures" style="@style/PixelValue"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp"
            app:layout_constraintStart_toStartOf="@id/sbC3" app:layout_constraintEnd_toEndOf="@id/sbC3"
            app:layout_constraintTop_toTopOf="@id/sbStatY" app:layout_constraintBottom_toBottomOf="@id/sbStatY" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- scouting report, right side (original position and size) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/scouting"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintDimensionRatio="H,440:320"
        app:layout_constraintWidth_percent="0.28"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@id/playerCard"
        app:layout_constraintEnd_toEndOf="@id/llActions"
        app:layout_constraintBottom_toTopOf="@id/llActions">

        <ImageView
            android:layout_width="0dp" android:layout_height="0dp"
            android:scaleType="fitXY" android:src="@drawable/scouting"
            android:importantForAccessibility="no"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />

        <androidx.constraintlayout.widget.Guideline android:id="@+id/scLa"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" app:layout_constraintGuide_percent="0.05" />
        <androidx.constraintlayout.widget.Guideline android:id="@+id/scLaS"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" app:layout_constraintGuide_percent="0.12" />
        <androidx.constraintlayout.widget.Guideline android:id="@+id/scLb"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" app:layout_constraintGuide_percent="0.30" />
        <androidx.constraintlayout.widget.Guideline android:id="@+id/scRa"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" app:layout_constraintGuide_percent="0.70" />
        <androidx.constraintlayout.widget.Guideline android:id="@+id/scRb"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" app:layout_constraintGuide_percent="0.95" />
        <androidx.constraintlayout.widget.Guideline android:id="@+id/scPipX"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" app:layout_constraintGuide_percent="0.745" />
        <androidx.constraintlayout.widget.Guideline android:id="@+id/scY1"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" app:layout_constraintGuide_percent="0.294" />
        <androidx.constraintlayout.widget.Guideline android:id="@+id/scY2"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" app:layout_constraintGuide_percent="0.425" />
        <androidx.constraintlayout.widget.Guideline android:id="@+id/scY3"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" app:layout_constraintGuide_percent="0.575" />
        <androidx.constraintlayout.widget.Guideline android:id="@+id/scY4"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" app:layout_constraintGuide_percent="0.725" />
        <androidx.constraintlayout.widget.Guideline android:id="@+id/scY5"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" app:layout_constraintGuide_percent="0.869" />

        <TextView android:id="@+id/scYouClan" style="@style/InkValue"
            android:layout_width="0dp" android:layout_height="wrap_content"
            app:autoSizeTextType="uniform" app:autoSizeMinTextSize="4sp" app:autoSizeMaxTextSize="7sp"
            app:layout_constraintStart_toStartOf="@id/scLa" app:layout_constraintEnd_toEndOf="@id/scLb"
            app:layout_constraintTop_toTopOf="@id/scY1" app:layout_constraintBottom_toBottomOf="@id/scY1" />
        <TextView android:id="@+id/scEnemyClan" style="@style/InkValue"
            android:layout_width="0dp" android:layout_height="wrap_content"
            app:autoSizeTextType="uniform" app:autoSizeMinTextSize="4sp" app:autoSizeMaxTextSize="7sp"
            app:layout_constraintStart_toStartOf="@id/scRa" app:layout_constraintEnd_toEndOf="@id/scRb"
            app:layout_constraintTop_toTopOf="@id/scY1" app:layout_constraintBottom_toBottomOf="@id/scY1" />

        <TextView android:id="@+id/scYouBest" style="@style/InkValue"
            android:layout_width="0dp" android:layout_height="wrap_content"
            app:autoSizeTextType="uniform" app:autoSizeMinTextSize="5sp" app:autoSizeMaxTextSize="10sp"
            app:layout_constraintStart_toStartOf="@id/scLaS" app:layout_constraintEnd_toEndOf="@id/scLb"
            app:layout_constraintTop_toTopOf="@id/scY2" app:layout_constraintBottom_toBottomOf="@id/scY2" />
        <TextView android:id="@+id/scEnemyBest" style="@style/InkValue"
            android:layout_width="0dp" android:layout_height="wrap_content"
            app:autoSizeTextType="uniform" app:autoSizeMinTextSize="5sp" app:autoSizeMaxTextSize="10sp"
            app:layout_constraintStart_toStartOf="@id/scRa" app:layout_constraintEnd_toEndOf="@id/scRb"
            app:layout_constraintTop_toTopOf="@id/scY2" app:layout_constraintBottom_toBottomOf="@id/scY2" />

        <TextView android:id="@+id/scYouNext" style="@style/InkValue"
            android:layout_width="0dp" android:layout_height="wrap_content"
            app:autoSizeTextType="uniform" app:autoSizeMinTextSize="5sp" app:autoSizeMaxTextSize="10sp"
            app:layout_constraintStart_toStartOf="@id/scLa" app:layout_constraintEnd_toEndOf="@id/scLb"
            app:layout_constraintTop_toTopOf="@id/scY3" app:layout_constraintBottom_toBottomOf="@id/scY3" />
        <TextView android:id="@+id/scEnemyNext" style="@style/InkValue"
            android:layout_width="0dp" android:layout_height="wrap_content"
            app:autoSizeTextType="uniform" app:autoSizeMinTextSize="5sp" app:autoSizeMaxTextSize="10sp"
            app:layout_constraintStart_toStartOf="@id/scRa" app:layout_constraintEnd_toEndOf="@id/scRb"
            app:layout_constraintTop_toTopOf="@id/scY3" app:layout_constraintBottom_toBottomOf="@id/scY3" />

        <TextView android:id="@+id/scYouCapt" style="@style/InkValue"
            android:layout_width="0dp" android:layout_height="wrap_content"
            app:autoSizeTextType="uniform" app:autoSizeMinTextSize="5sp" app:autoSizeMaxTextSize="10sp"
            app:layout_constraintStart_toStartOf="@id/scLa" app:layout_constraintEnd_toEndOf="@id/scLb"
            app:layout_constraintTop_toTopOf="@id/scY4" app:layout_constraintBottom_toBottomOf="@id/scY4" />
        <TextView android:id="@+id/scEnemyCapt" style="@style/InkValue"
            android:layout_width="0dp" android:layout_height="wrap_content"
            app:autoSizeTextType="uniform" app:autoSizeMinTextSize="5sp" app:autoSizeMaxTextSize="10sp"
            app:layout_constraintStart_toStartOf="@id/scRa" app:layout_constraintEnd_toEndOf="@id/scRb"
            app:layout_constraintTop_toTopOf="@id/scY4" app:layout_constraintBottom_toBottomOf="@id/scY4" />

        <LinearLayout
            android:id="@+id/llPips"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="@id/scPipX" app:layout_constraintEnd_toEndOf="@id/scPipX"
            app:layout_constraintTop_toTopOf="@id/scY5" app:layout_constraintBottom_toBottomOf="@id/scY5">
            <View android:id="@+id/pip1" android:layout_width="7dp" android:layout_height="10dp" android:layout_margin="2dp" />
            <View android:id="@+id/pip2" android:layout_width="7dp" android:layout_height="10dp" android:layout_margin="2dp" />
            <View android:id="@+id/pip3" android:layout_width="7dp" android:layout_height="10dp" android:layout_margin="2dp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <CheckBox
        android:id="@+id/checkCapture"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Capture if I win"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        app:layout_constraintBottom_toTopOf="@id/llActions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/llActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/btnQuit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView android:id="@+id/btnSkip" android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1" android:layout_margin="4dp" android:background="@drawable/btn_empty_start"
            android:fontFamily="@font/pixel_regular" android:text="SKIP" android:gravity="center"
            android:textColor="@color/black" android:textSize="14sp"
            android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/btnFight" android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1" android:layout_margin="4dp" android:background="@drawable/btn_empty_start"
            android:fontFamily="@font/pixel_regular" android:text="FIGHT" android:gravity="center"
            android:textColor="@color/black" android:textSize="14sp"
            android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/btnTrump" android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1" android:layout_margin="4dp" android:background="@drawable/btn_empty_start"
            android:fontFamily="@font/pixel_regular" android:text="TRUMP" android:gravity="center"
            android:textColor="@color/black" android:textSize="14sp"
            android:clickable="true" android:focusable="true" />
    </LinearLayout>

    <TextView
