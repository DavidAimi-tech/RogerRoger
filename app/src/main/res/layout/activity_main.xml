<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_min">

    <!-- Your existing button column -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="32dp">

        <!-- Empty space that covers the title area of the background -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="59" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="58"
            android:gravity="top|center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/btnStart"
                android:layout_width="240dp"
                android:layout_height="80dp"
                android:background="@drawable/btn_empty_small"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/pixel_regular"
                android:gravity="center"
                android:text="PLAY"
                android:textColor="#F4EFE6"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSettings"
                android:layout_width="240dp"
                android:layout_height="80dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_empty_small"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/pixel_regular"
                android:gravity="center"
                android:text="SETTINGS"
                android:textColor="#F4EFE6"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnExit"
                android:layout_width="240dp"
                android:layout_height="80dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_empty_small"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/pixel_regular"
                android:gravity="center"
                android:text="EXIT"
                android:textColor="#F4EFE6"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Question mark icon, top right corner -->
    <ImageView
        android:id="@+id/btnHelp"
        android:layout_width="102dp"
        android:layout_height="88dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:clickable="true"
        android:contentDescription="Help"
        android:focusable="true"
        android:scaleType="fitCenter"
        android:src="@drawable/btn_howto" />
</FrameLayout>